pragma language_version >= 0.20;

import CompactStandardLibrary;

export struct AuctionResult {
    hasWinner: Boolean,
    winningBidder: Bytes<32>,
    winningBid: Uint<64>
}

// One deployed contract owns the directory and lifecycle for every auction.
export ledger auctionNames: Map<Bytes<32>, Bytes<64>>;
export ledger auctionCreators: Map<Bytes<32>, Bytes<32>>;
export ledger auctionActive: Map<Bytes<32>, Boolean>;
export ledger revealActive: Map<Bytes<32>, Boolean>;
export ledger winnerDetermined: Map<Bytes<32>, Boolean>;
export ledger isFinalized: Map<Bytes<32>, Boolean>;
export ledger hasWinner: Map<Bytes<32>, Boolean>;
export ledger hasRevealedBids: Map<Bytes<32>, Boolean>;
export ledger bids: Map<Bytes<32>, Bytes<32>>;
export ledger bidAuctionIds: Map<Bytes<32>, Bytes<32>>;
export ledger bidders: Map<Bytes<32>, Bytes<32>>;
export ledger revealedBids: Map<Bytes<32>, Uint<64>>;
export ledger highestBids: Map<Bytes<32>, Uint<64>>;
export ledger highestBidders: Map<Bytes<32>, Bytes<32>>;
export ledger winningBids: Map<Bytes<32>, Uint<64>>;
export ledger winningBidders: Map<Bytes<32>, Bytes<32>>;

constructor() {}

// A unique random ID is generated by the client and recorded with this tx.
export circuit createAuction(auctionId: Bytes<32>, name: Bytes<64>): [] {
    assert(!auctionCreators.member(disclose(auctionId)), "Auction ID already exists");
    const creator = ownPublicKey().bytes;
    auctionCreators.insert(disclose(auctionId), disclose(creator));
    auctionNames.insert(disclose(auctionId), disclose(name));
    auctionActive.insert(disclose(auctionId), true);
    revealActive.insert(disclose(auctionId), false);
    winnerDetermined.insert(disclose(auctionId), false);
    isFinalized.insert(disclose(auctionId), false);
    hasWinner.insert(disclose(auctionId), false);
    hasRevealedBids.insert(disclose(auctionId), false);
    highestBids.insert(disclose(auctionId), 0);
    highestBidders.insert(disclose(auctionId), default<Bytes<32>>);
    winningBids.insert(disclose(auctionId), 0);
    winningBidders.insert(disclose(auctionId), default<Bytes<32>>);
}

export circuit submitBid(auctionId: Bytes<32>, commitment: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(auctionActive.lookup(disclose(auctionId)), "Auction is closed");
    const bidder = ownPublicKey().bytes;
    const bidId = persistentHash<[Bytes<32>, Bytes<32>]>([auctionId, bidder]);
    assert(!bids.member(disclose(bidId)), "Bidder already submitted a bid");
    bids.insert(disclose(bidId), disclose(commitment));
    bidAuctionIds.insert(disclose(bidId), disclose(auctionId));
    bidders.insert(disclose(bidId), disclose(bidder));
}

export circuit closeAuction(auctionId: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(auctionCreators.lookup(disclose(auctionId)) == ownPublicKey().bytes, "Only the auction creator can close bidding");
    assert(auctionActive.lookup(disclose(auctionId)), "Auction already closed");
    auctionActive.insert(disclose(auctionId), false);
    revealActive.insert(disclose(auctionId), true);
}

export circuit revealBid(auctionId: Bytes<32>, bid: Uint<64>, nonce: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(!auctionActive.lookup(disclose(auctionId)), "Auction is still active");
    assert(revealActive.lookup(disclose(auctionId)), "Reveal phase is closed");
    const bidder = ownPublicKey().bytes;
    const bidId = persistentHash<[Bytes<32>, Bytes<32>]>([auctionId, bidder]);
    assert(bids.member(disclose(bidId)), "Bidder has not submitted a bid");
    assert(!revealedBids.member(disclose(bidId)), "Bid already revealed");

    const computedCommitment = persistentHash<[Uint<64>, Bytes<32>]>([bid, nonce]);
    assert(computedCommitment == bids.lookup(disclose(bidId)), "Commitment mismatch");
    revealedBids.insert(disclose(bidId), disclose(bid));

    if (!hasRevealedBids.lookup(disclose(auctionId)) || disclose(bid > highestBids.lookup(disclose(auctionId)))) {
        highestBids.insert(disclose(auctionId), disclose(bid));
        highestBidders.insert(disclose(auctionId), disclose(bidder));
        hasRevealedBids.insert(disclose(auctionId), true);
    }
}

export circuit closeReveal(auctionId: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(auctionCreators.lookup(disclose(auctionId)) == ownPublicKey().bytes, "Only the auction creator can close reveal");
    assert(!auctionActive.lookup(disclose(auctionId)), "Auction is still active");
    assert(revealActive.lookup(disclose(auctionId)), "Reveal phase already closed");
    revealActive.insert(disclose(auctionId), false);
}

export circuit determineWinner(auctionId: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(!auctionActive.lookup(disclose(auctionId)), "Auction is still active");
    assert(!revealActive.lookup(disclose(auctionId)), "Reveal phase is not complete");
    assert(!winnerDetermined.lookup(disclose(auctionId)), "Winner already determined");
    winnerDetermined.insert(disclose(auctionId), true);
    if (hasRevealedBids.lookup(disclose(auctionId))) {
        winningBids.insert(disclose(auctionId), highestBids.lookup(disclose(auctionId)));
        winningBidders.insert(disclose(auctionId), highestBidders.lookup(disclose(auctionId)));
        hasWinner.insert(disclose(auctionId), true);
    }
}

export circuit finalizeAuction(auctionId: Bytes<32>): [] {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(auctionCreators.lookup(disclose(auctionId)) == ownPublicKey().bytes, "Only the auction creator can finalize");
    assert(!auctionActive.lookup(disclose(auctionId)), "Auction is still active");
    assert(!revealActive.lookup(disclose(auctionId)), "Reveal phase is not complete");
    assert(winnerDetermined.lookup(disclose(auctionId)), "Determine the winner first");
    assert(!isFinalized.lookup(disclose(auctionId)), "Auction already finalized");
    isFinalized.insert(disclose(auctionId), true);
}

export circuit getAuctionResult(auctionId: Bytes<32>): AuctionResult {
    assert(auctionCreators.member(disclose(auctionId)), "Auction does not exist");
    assert(isFinalized.lookup(disclose(auctionId)), "Auction is not finalized");
    return AuctionResult {
        hasWinner: hasWinner.lookup(disclose(auctionId)),
        winningBidder: winningBidders.lookup(disclose(auctionId)),
        winningBid: winningBids.lookup(disclose(auctionId))
    };
}
